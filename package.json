{
  "name": "visual-novel-studio",
  "version": "2.20.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build && node scripts/worker.mjs && node scripts/standalone.mjs && node scripts/offline.mjs",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:offline": "node tests/offline.mjs",
    "test:standalone": "node tests/standalone.mjs",
    "test:production": "node tests/production.mjs"
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "idb": "^8.0.0",
    "immer": "^11.2.9",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
